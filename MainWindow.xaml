<Window x:Class="MyDairy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyDairy - Register"
        Height="750"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <!-- Window Gradient -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#546E7A" Offset="0"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
                CornerRadius="25,0,0,25"
                Background="#25FFFFFF">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="2"
                                  Opacity="0.2"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <Border Width="140"
                        Height="140"
                        CornerRadius="70"
                        Background="#40FFFFFF">

                    <TextBlock Text="📔"
                               FontSize="70"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <TextBlock Text="MyDairy"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,30,0,10"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Capture Every Moment&#10;Keep Every Memory"
                           FontSize="18"
                           TextAlignment="Center"
                           Foreground="White"
                           Margin="20"/>

            </StackPanel>

        </Border>

        <!-- RIGHT PANEL -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="0,25,25,0"
                Padding="40">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="2"
                                  Opacity="0.15"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Create Account"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#333"/>

                <TextBlock Text="Start your diary journey today"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,30"/>

                <TextBlock Text="Full Name"
                           FontWeight="Bold"/>
                <TextBox x:Name="txtFullName"
                         Height="42"
                         Margin="0,5,0,15"
                         Padding="10"/>

                <TextBlock Text="Email"
                           FontWeight="Bold"/>
                <TextBox x:Name="txtEmail"
                         Height="42"
                         Margin="0,5,0,15"
                         Padding="10"/>

                <TextBlock Text="Username"
                           FontWeight="Bold"/>
                <TextBox x:Name="txtUsername"
                         Height="42"
                         Margin="0,5,0,15"
                         Padding="10"/>

                <TextBlock Text="Password"
                           FontWeight="Bold"/>
                <PasswordBox x:Name="txtPassword"
                             Height="42"
                             Margin="0,5,0,15"
                             Padding="10"/>

                <TextBlock Text="Confirm Password"
                           FontWeight="Bold"/>
                <PasswordBox x:Name="txtConfirmPassword"
                             Height="42"
                             Margin="0,5,0,25"
                             Padding="10"/>

                <!-- Gradient Register Button -->
                <Button Height="48"
                        FontWeight="Bold"
                        FontSize="16"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnRegister_Click">

                    <Button.Content>
                        CREATE ACCOUNT
                    </Button.Content>

                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">
                            <GradientStop Color="#546E7A"/>
                            <GradientStop Color="#263238"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>

                </Button>

                <Button Content="Already have an account? Login"
                        Margin="0,20,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#333"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnGoToLogin_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>