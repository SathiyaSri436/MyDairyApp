<Window x:Class="MyDairy.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyDairy Dashboard"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <!-- Window Background -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#546E7A" Offset="0"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="20,0"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#55FFFFFF"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border Grid.Row="0"
                Background="#22000000">

            <DockPanel Margin="20">

                <TextBlock Text="📖 MyDairy"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           DockPanel.Dock="Left"/>

                <TextBlock x:Name="txtWelcome"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Right"/>

            </DockPanel>

        </Border>

        <!-- Main -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="220"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- Sidebar -->

            <Border Margin="15"
                    CornerRadius="20"
                    Background="#25FFFFFF">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="15"
                                      Opacity="0.25"/>

                </Border.Effect>

                <StackPanel Margin="10">

                    <TextBlock Text="MENU"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="15"/>

                    <Button Style="{StaticResource MenuButton}"
                            Click="BtnMyDairy_Click"
                            Content="🏠   My Diary"/>

                    <Button Style="{StaticResource MenuButton}"
                            Click="BtnNewEntry_Click"
                            Content="✍   New Entry"/>

                    <Button Style="{StaticResource MenuButton}"
                            Click="BtnProfile_Click"
                            Content="👤   My Profile"/>

                    <Button Style="{StaticResource MenuButton}"
                            Click="BtnExpenses_Click"
                            Content="💰   Expenses"/>

                    <Separator Margin="10"/>

                    <Button Style="{StaticResource MenuButton}"
                            Click="BtnLogout_Click"
                            Content="🚪   Logout"/>

                </StackPanel>

            </Border>

            <!-- Content -->

            <Border Grid.Column="1"
                    Margin="15"
                    CornerRadius="20"
                    Background="#EEFFFFFF">

                <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"/>

            </Border>

        </Grid>

    </Grid>

</Window>