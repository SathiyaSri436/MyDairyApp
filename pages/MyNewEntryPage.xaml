<Page x:Class="MyDairy.pages.MyNewEntryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MyNewEntryPage">

    <Grid>

        <!-- Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#546E7A" Offset="0"/>
                <GradientStop Color="#263238" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25">

                <!-- Header -->
                <Border Background="#30FFFFFF"
                        CornerRadius="20"
                        Padding="20"
                        Margin="0,0,0,20">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"
                                          ShadowDepth="3"
                                          Opacity="0.25"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="📝 New Diary Entry"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Capture today's beautiful memories"
                                   FontSize="15"
                                   Foreground="White"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Entry Card -->

                <Border Background="White"
                        CornerRadius="20"
                        Padding="25">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"
                                          Opacity="0.20"/>
                    </Border.Effect>

                    <StackPanel>

                        <!-- Title -->

                        <TextBlock Text="Entry Title"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Border Background="#F5F7FA"
                                CornerRadius="10"
                                Margin="0,8,0,18">

                            <TextBox x:Name="txttitle"
                                     Height="40"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="10"
                                     FontSize="15"/>

                        </Border>

                        <!-- Date -->

                        <TextBlock Text="Date"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <DatePicker x:Name="dpDate"
                                    Height="40"
                                    Margin="0,8,0,18"/>

                        <!-- Time -->

                        <TextBlock Text="Time"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Border Background="#F5F7FA"
                                CornerRadius="10"
                                Margin="0,8,0,18">

                            <TextBox x:Name="txtTime"
                                     Height="40"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     Padding="10"
                                     FontSize="15"/>

                        </Border>

                        <!-- Content -->

                        <TextBlock Text="Diary Content"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Border Background="#F5F7FA"
                                CornerRadius="10"
                                Margin="0,8,0,25">

                            <TextBox x:Name="txtdate"
                                     Height="180"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12"
                                     FontSize="15"/>

                        </Border>

                        <!-- Save Button -->

                        <Button Content="💾 Save Entry"
                                Height="48"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnSaveEntry_Click">

                            <Button.Background>

                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">

                                    <GradientStop Color="#546E7A"/>

                                    <GradientStop Color="#263238"
                                                  Offset="1"/>

                                </LinearGradientBrush>

                            </Button.Background>

                        </Button>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>