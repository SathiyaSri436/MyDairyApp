<Page x:Class="MyDairy.pages.MyExpensesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MyExpensesPage">

    <Grid>

        <!-- Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#546E7A" Offset="0"/>
                <GradientStop Color="#263238" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <!-- Header -->
                <Border Background="#25FFFFFF"
                        CornerRadius="20"
                        Padding="20">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"
                                          ShadowDepth="3"
                                          Opacity="0.25"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="💰 My Expenses"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Track your daily expenses"
                                   FontSize="15"
                                   Foreground="White"/>

                    </StackPanel>

                </Border>

                <!-- Expense Card -->
                <Border Background="White"
                        CornerRadius="20"
                        Margin="0,25,0,20"
                        Padding="25">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"
                                          Opacity="0.2"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Expense Name"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Border Background="#F4F6F9"
                                CornerRadius="10"
                                Margin="0,8,0,15">

                            <TextBox x:Name="txtExpenseName"
                                     Height="40"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="10"
                                     FontSize="15"/>

                        </Border>

                        <TextBlock Text="Amount"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <Border Background="#F4F6F9"
                                CornerRadius="10"
                                Margin="0,8,0,20">

                            <TextBox x:Name="txtAmount"
                                     Height="40"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="10"
                                     FontSize="15"/>

                        </Border>

                        <!-- Button -->
                        <Button Content="➕ Add Expense"
                                Height="45"
                                FontWeight="Bold"
                                FontSize="16"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnAddExpense_Click">

                            <Button.Background>

                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">

                                    <GradientStop Color="#546E7A"/>

                                    <GradientStop Color="#263238"
                                                  Offset="1"/>

                                </LinearGradientBrush>

                            </Button.Background>

                        </Button>

                    </StackPanel>

                </Border>

                <!-- Expense List -->

                <Border Background="White"
                        CornerRadius="20"
                        Padding="20">

                    <Border.Effect>

                        <DropShadowEffect BlurRadius="15"
                                          Opacity="0.2"/>

                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Expense History"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <ListBox x:Name="lstExpenses"
                                 Height="220"
                                 FontSize="15"
                                 BorderThickness="0"/>

                    </StackPanel>

                </Border>

                <!-- Total Card -->

                <Border Margin="0,20,0,0"
                        Background="#25FFFFFF"
                        CornerRadius="20"
                        Padding="20">

                    <TextBlock x:Name="txtTotal"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>