<Page x:Class="MyDairy.pages.MyProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MyProfilePage">

    <Grid>

        <!-- Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#546E7A" Offset="0"/>
                <GradientStop Color="#263238" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25">

                <!-- Header -->
                <Border Background="#30FFFFFF"
                        CornerRadius="20"
                        Padding="20"
                        Margin="0,0,0,20">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"
                                          ShadowDepth="3"
                                          Opacity="0.25"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="👤 My Profile"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Manage your profile information"
                                   FontSize="15"
                                   Foreground="White"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Profile Card -->
                <Border Background="White"
                        CornerRadius="20"
                        Padding="30"
                        HorizontalAlignment="Center"
                        Width="500">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"
                                          ShadowDepth="3"
                                          Opacity="0.20"/>
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center">

                        <!-- Profile Image -->
                        <Border Width="170"
                                Height="170"
                                CornerRadius="85"
                                BorderBrush="#667EEA"
                                BorderThickness="4">

                            <Ellipse>

                                <Ellipse.Fill>
                                    <ImageBrush x:Name="ProfileBrush"
                                                Stretch="UniformToFill"/>
                                </Ellipse.Fill>

                            </Ellipse>

                        </Border>

                        <!-- Upload Button -->
                        <Button Width="180"
                                Height="45"
                                Margin="0,20,0,25"
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnUploadPhoto_Click">

                            <Button.Content>
                                📷 Upload Photo
                            </Button.Content>

                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <GradientStop Color="#546E7A"/>
                                    <GradientStop Color="#263238"
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>

                        </Button>

                        <!-- About Me -->
                        <TextBlock Text="About Me"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   Margin="0,0,0,10"/>

                        <Border Background="#F4F6F9"
                                CornerRadius="12"
                                Padding="5">

                            <TextBox x:Name="txtAboutMe"
                                     Height="180"
                                     Width="380"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="15"
                                     Padding="10"/>

                        </Border>

                        <!-- Save Button -->
                        <Button Width="200"
                                Height="48"
                                Margin="0,30,0,0"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnSaveChanges_Click">

                            <Button.Content>
                                💾 Save Changes
                            </Button.Content>

                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <GradientStop Color="#546E7A"/>
                                    <GradientStop Color="#263238"
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>

                        </Button>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>