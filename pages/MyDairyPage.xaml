<Page x:Class="MyDairy.pages.MyDairyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MyDiaryPage"
      Height="700">

    <!-- Background -->
    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#546E7A" Offset="0"/>
                <GradientStop Color="#263238" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25">

                <!-- Header -->
                <Border Height="100"
                        CornerRadius="20"
                        Background="#30FFFFFF"
                        Padding="20">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"
                                          ShadowDepth="3"
                                          Opacity="0.3"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="📖 My Diary"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Capture every beautiful memory"
                                   FontSize="15"
                                   Foreground="White"/>

                    </StackPanel>

                </Border>

                <!-- Profile Card -->

                <Border Margin="0,20,0,20"
                        CornerRadius="20"
                        Background="#FDFDFD"
                        Padding="20">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"
                                          Opacity="0.2"/>
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center">

                        <Border Width="140"
                                Height="140"
                                CornerRadius="70"
                                BorderBrush="#667EEA"
                                BorderThickness="4">

                            <Ellipse>

                                <Ellipse.Fill>

                                    <ImageBrush x:Name="imgProfile"
                                                Stretch="UniformToFill"/>

                                </Ellipse.Fill>

                            </Ellipse>

                        </Border>

                        <TextBlock x:Name="txtName"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,15,0,5"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtEmail"
                                   FontSize="15"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtAboutMe"
                                   Margin="0,15,0,0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- Diary Entries -->

                <TextBlock Text="Recent Diary Entries"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="5"/>

                <ListView x:Name="lstDiary"
                          Background="Transparent"
                          BorderThickness="0">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border Background="White"
                                    CornerRadius="15"
                                    Margin="0,10"
                                    Padding="18">

                                <Border.Effect>

                                    <DropShadowEffect BlurRadius="10"
                                                      Opacity="0.15"/>

                                </Border.Effect>

                                <StackPanel>

                                    <DockPanel>

                                        <TextBlock Text="{Binding Date}"
                                                   FontWeight="Bold"
                                                   Foreground="#667EEA"
                                                   DockPanel.Dock="Left"/>

                                        <Border Background="#667EEA"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                HorizontalAlignment="Right">

                                            <TextBlock Text="{Binding Mood}"
                                                       Foreground="White"/>

                                        </Border>

                                    </DockPanel>

                                    <TextBlock Text="{Binding Title}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="0,10,0,8"/>

                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               Foreground="#555"/>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,15,0,0">

                                        <Button Content="👁 View"
                                                Width="90"
                                                Margin="5"
                                                Background="#667EEA"
                                                Foreground="White"/>

                                        <Button Content="✏ Edit"
                                                Width="90"
                                                Margin="5"
                                                Background="#00B894"
                                                Foreground="White"/>

                                        <Button Content="🗑 Delete"
                                                Width="90"
                                                Margin="5"
                                                Background="#E74C3C"
                                                Foreground="White"/>

                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>